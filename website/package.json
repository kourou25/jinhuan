{
  "name": "meme-hall",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "deploy": "node scripts/deploy.mjs",
    "db:init:local": "wrangler d1 execute meme-hall --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute meme-hall --local --file=seed.sql",
    "db:seed": "wrangler d1 execute meme-hall --remote --file=seed.sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "dev:wt": "vite dev --port 8788",
    "build": "vite build && node scripts/check-bundle.mjs",
    "schema:check": "node scripts/schema-snapshot.mjs --check",
    "deploy:go": "node scripts/deploy.mjs --yes",
    "build:server": "node server/build.mjs",
    "start:server": "node server/main.mjs"
  },
  "dependencies": {
    "@hono/valibot-validator": "0.6.1",
    "@tanstack/react-query": "5.104.2",
    "hono": "^4.6.0",
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "valibot": "1.5.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5.6.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
